{
  "repository": [
    {
      "path": "default_branch",
      "value": "master"
    },
    {
      "path": "has_issues",
      "value": true
    },
    {
      "path": "has_discussions",
      "value": true
    },
    {
      "path": "has_wiki",
      "value": false
    },
    {
      "path": "has_projects",
      "value": false
    },
    {
      "path": "allow_forking",
      "value": true
    },
    {
      "path": "allow_squash_merge",
      "value": true
    },
    {
      "path": "allow_merge_commit",
      "value": false
    },
    {
      "path": "allow_rebase_merge",
      "value": false
    },
    {
      "path": "allow_auto_merge",
      "value": false
    },
    {
      "path": "delete_branch_on_merge",
      "value": false
    },
    {
      "path": "security_and_analysis.secret_scanning.status",
      "value": "enabled"
    },
    {
      "path": "security_and_analysis.secret_scanning_push_protection.status",
      "value": "enabled"
    },
    {
      "path": "squash_merge_commit_title",
      "value": "PR_TITLE"
    }
  ],
  "endpoints": [
    {
      "endpoint": "actions/permissions",
      "settings": [
        {
          "path": "enabled",
          "value": true
        },
        {
          "path": "allowed_actions",
          "value": "selected"
        },
        {
          "path": "sha_pinning_required",
          "value": true
        }
      ]
    },
    {
      "endpoint": "actions/permissions/workflow",
      "settings": [
        {
          "path": "default_workflow_permissions",
          "value": "read"
        },
        {
          "path": "can_approve_pull_request_reviews",
          "value": false
        }
      ]
    },
    {
      "endpoint": "actions/permissions/fork-pr-contributor-approval",
      "settings": [
        {
          "path": "approval_policy",
          "value": "all_external_contributors"
        }
      ]
    },
    {
      "endpoint": "actions/permissions/fork-pr-workflows-private-repos",
      "settings": [
        {
          "path": "send_write_tokens_to_workflows",
          "value": false
        },
        {
          "path": "send_secrets_and_variables",
          "value": false
        }
      ]
    },
    {
      "endpoint": "actions/permissions/artifact-and-log-retention",
      "settings": [
        {
          "path": "days",
          "value": 90
        }
      ]
    },
    {
      "endpoint": "automated-security-fixes",
      "settings": [
        {
          "path": "enabled",
          "value": true
        }
      ]
    },
    {
      "endpoint": "private-vulnerability-reporting",
      "settings": [
        {
          "path": "enabled",
          "value": true
        }
      ]
    }
  ],
  "requiredChecks": ["ci-success", "secrets", "dependency-review", "pr-gate"],
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "include": ["~DEFAULT_BRANCH"],
      "bypass": [],
      "rules": [
        {
          "path": "pull_request",
          "value": true
        },
        {
          "path": "pull_request.parameters.required_approving_review_count",
          "value": 0
        },
        {
          "path": "pull_request.parameters.require_code_owner_review",
          "value": false
        },
        {
          "path": "pull_request.parameters.dismiss_stale_reviews_on_push",
          "value": true
        },
        {
          "path": "pull_request.parameters.require_last_push_approval",
          "value": false
        },
        {
          "path": "pull_request.parameters.required_review_thread_resolution",
          "value": true
        },
        {
          "path": "pull_request.parameters.allowed_merge_methods",
          "value": ["squash"]
        },
        {
          "path": "required_status_checks",
          "value": true
        },
        {
          "path": "required_status_checks.parameters.strict_required_status_checks_policy",
          "value": true
        },
        {
          "path": "required_status_checks.parameters.required_status_checks",
          "value": "requiredChecks"
        },
        {
          "path": "required_linear_history",
          "value": true
        },
        {
          "path": "non_fast_forward",
          "value": true
        },
        {
          "path": "deletion",
          "value": true
        },
        {
          "path": "required_signatures",
          "value": true
        }
      ]
    },
    {
      "name": "DEVELOP",
      "target": "branch",
      "include": ["refs/heads/DEVELOP"],
      "bypass": [],
      "rules": [
        {
          "path": "pull_request",
          "value": true
        },
        {
          "path": "pull_request.parameters.required_approving_review_count",
          "value": 0
        },
        {
          "path": "pull_request.parameters.require_code_owner_review",
          "value": false
        },
        {
          "path": "pull_request.parameters.dismiss_stale_reviews_on_push",
          "value": true
        },
        {
          "path": "pull_request.parameters.require_last_push_approval",
          "value": false
        },
        {
          "path": "pull_request.parameters.required_review_thread_resolution",
          "value": true
        },
        {
          "path": "pull_request.parameters.allowed_merge_methods",
          "value": ["squash"]
        },
        {
          "path": "required_status_checks",
          "value": true
        },
        {
          "path": "required_status_checks.parameters.strict_required_status_checks_policy",
          "value": true
        },
        {
          "path": "required_status_checks.parameters.required_status_checks",
          "value": "requiredChecks"
        },
        {
          "path": "required_linear_history",
          "value": true
        },
        {
          "path": "non_fast_forward",
          "value": true
        },
        {
          "path": "deletion",
          "value": true
        },
        {
          "path": "required_signatures",
          "value": true
        }
      ]
    },
    {
      "name": "task/*",
      "target": "branch",
      "include": ["refs/heads/task/*"],
      "bypass": [],
      "rules": [
        {
          "path": "deletion",
          "value": true
        },
        {
          "path": "creation",
          "value": false
        },
        {
          "path": "non_fast_forward",
          "value": false
        }
      ]
    },
    {
      "name": "v*-creation",
      "target": "tag",
      "include": ["refs/tags/v*"],
      "bypass": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ],
      "rules": [
        {
          "path": "creation",
          "value": true
        }
      ]
    },
    {
      "name": "v*-immutable",
      "target": "tag",
      "include": ["refs/tags/v*"],
      "bypass": [],
      "rules": [
        {
          "path": "update",
          "value": true
        },
        {
          "path": "deletion",
          "value": true
        }
      ]
    }
  ],
  "releaseReviewer": "wojciechlesniak",
  "allowedRepositorySecrets": [],
