{
  "name": "overmind",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=12.11.2 <13"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "dev": "node --import tsx tools/dev/run.ts",
    "dev:tauri": "pnpm --filter @overmind/desktop tauri dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0 && pnpm lint:react && node tools/eslint/check-disable-reasons.mjs && pnpm check:tauri",
    "lint:react": "oxlint --disable-nested-config --config .oxlintrc.json --deny-warnings apps/desktop packages/ui-kit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @overmind/desktop run test:e2e",
    "test:visual": "pnpm --filter @overmind/desktop run test:visual",
    "test:escape": "tsx tools/escape-tests/run.ts",
    "storybook": "pnpm --filter @overmind/ui-kit run storybook",
    "build:storybook": "pnpm --filter @overmind/ui-kit run build:storybook",
    "check:boundaries": "tsx tools/check-boundaries/run.ts",
    "check:licenses": "tsx tools/check-licenses/run.ts",
    "check:deps": "tsx tools/deps-policy/run.ts",
    "check:tasks": "tsx tools/tasks/lint.ts",
    "check:owns": "tsx tools/tasks/check-owns.ts",
    "check:docs": "node --import tsx tools/docs-check/run.ts",
    "check:headers": "tsx tools/check-headers/run.ts",
    "check:contracts": "tsx tools/gen-contracts/check-additive.ts",
    "gen:contracts": "tsx tools/gen-contracts/run.ts",
    "gen:task-index": "tsx tools/tasks/gen-index.ts",
    "audit": "pnpm audit --audit-level=high --prod",
    "sbom": "tsx tools/sbom/generate.ts",
    "package:engine": "tsx tools/package-engine/run.ts",
    "check": "tsx tools/ci/check.ts",
    "prepare": "node tools/hooks/prepare.mjs",
    "task:claim": "tsx tools/tasks/claim.ts",
    "task:finish": "tsx tools/tasks/finish.ts",
    "task:status": "tsx tools/tasks/status.ts",
    "task:next": "tsx tools/tasks/next.ts",
    "task:release": "tsx tools/tasks/release.ts",
    "task:cleanup": "tsx tools/tasks/cleanup.ts",
    "test:int": "vitest run --config vitest.int.config.ts --project \"*-int\" --passWithNoTests",
    "check:tauri": "node tools/build/desktop/check-tauri-config.mjs",
    "check:agents-md": "tsx tools/agents-md/check.ts",
    "adr:new": "tsx tools/adr/new.ts",
    "gen:adr-index": "tsx tools/adr/gen-index.ts",
    "check:adr": "tsx tools/adr/check.ts",
    "adr:renumber": "tsx tools/adr/renumber.ts",
    "settings:audit": "tsx tools/repo-settings/audit.ts",
    "settings:labels": "tsx tools/repo-settings/sync-labels.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "entities": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "lefthook": "catalog:",
    "markdownlint": "catalog:",
    "oxlint": "catalog:",
    "postject": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "semver": "catalog:",
    "spdx-license-ids": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
